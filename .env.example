# 登录账号
# 注意：Windows 系统自带 USERNAME 环境变量（值为当前系统用户名），会覆盖这里的 USERNAME。
# 在 Windows 上本地部署时，请改用 AUDIONOTES_USERNAME / AUDIONOTES_PASSWORD（优先级更高）
USERNAME=admin
PASSWORD=admin
# AUDIONOTES_USERNAME=admin
# AUDIONOTES_PASSWORD=admin

# 数据库配置(需要与下面pg服务的配置一致)
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=audio_notes
POSTGRES_HOST=127.0.0.1

# ollama配置
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2:7b
OLLAMA_API_KEY=ollama
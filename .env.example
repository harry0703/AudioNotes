# 登录账号
USERNAME=admin
PASSWORD=admin
# 用于签发登录会话令牌。部署前使用安全随机值替换，例如：python -c "import secrets; print(secrets.token_hex(32))"
CHAINLIT_AUTH_SECRET=local-development-secret-change-before-deployment

# 日志级别，可选值包括 DEBUG、INFO、WARNING、ERROR
LOG_LEVEL=INFO

# Compose 默认从 GHCR 拉取公开镜像；私有镜像或镜像代理可在这里覆盖
AUDIO_NOTES_IMAGE=ghcr.io/harry0703/audio-notes:latest

# FunASR 配置。ASR_DEVICE 留空时自动选择设备；热词使用空格分隔
ASR_MODEL=FunAudioLLM/Fun-ASR-Nano-2512
ASR_DEVICE=
ASR_HOTWORDS=
# 纯文本笔记不需要说话人标签；生成带说话人的 SRT 时再开启
ASR_ENABLE_SPEAKER_DIARIZATION=false

# 单个音视频文件的上传上限，单位 MB
MAX_UPLOAD_SIZE_MB=2048

# ollama配置
OLLAMA_BASE_URL=http://localhost:11434/v1
# Docker 容器访问宿主机 Ollama 的地址，与本地运行地址分开配置
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_API_KEY=ollama
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_MAX_RETRIES=1
# 长转写超过此字符数时先分段提炼，最终再合并，避免超过模型上下文窗口
OLLAMA_SUMMARY_CHUNK_SIZE=6000
